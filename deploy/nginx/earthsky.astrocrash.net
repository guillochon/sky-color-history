# Earth's sky through time — earthsky.astrocrash.net
# Static files live in /var/www/html/earthsky (site/index.html).

server {
	listen 80;
	listen [::]:80;
	server_name earthsky.astrocrash.net;

	location /.well-known/acme-challenge/ {
		root /var/www/html;
	}

	location / {
		return 301 https://$host$request_uri;
	}
}

server {
	listen 443 ssl;
	listen [::]:443 ssl;
	server_name earthsky.astrocrash.net;

	ssl_certificate /etc/letsencrypt/live/earthsky.astrocrash.net/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/earthsky.astrocrash.net/privkey.pem;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_ciphers HIGH:!aNULL:!MD5;

	root /var/www/html/earthsky;
	index index.html;

	gzip on;
	gzip_comp_level 5;
	gzip_min_length 1000;
	# spectra.bin and day/*.bin are application/octet-stream. gen_site.py also writes .gz
	# copies of the page and the data, which gzip_static serves as they are.
	gzip_types text/css application/javascript application/json image/svg+xml application/octet-stream;
	gzip_static on;
	gzip_vary on;

	location / {
		try_files $uri $uri/ =404;
		add_header Cache-Control "public, max-age=300";
	}
}
